rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가족 코드(8자리)를 아는 사람만 그 가족의 판을 읽고 쓸 수 있어요.
    // 목록 조회와 삭제는 막아서 다른 가족 코드를 알아낼 수 없게 했어요.
    match /families/{code} {
      allow get, create, update: if request.auth != null && code.size() == 8;
      allow list, delete: if false;
    }
  }
}
